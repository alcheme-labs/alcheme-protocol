  proposalId   String   @map("proposal_id") @db.VarChar(96)
  eventType    String   @map("event_type") @db.VarChar(32)
  actorUserId  Int?     @map("actor_user_id")
  eventPayload Json     @default("{}") @map("event_payload") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  proposal CircleEvolutionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt(sort: Desc)])
  @@map("circle_evolution_proposal_events")
}

model GuardianFinding {
  id                  String    @id @db.VarChar(96)
  ownerUserId         Int?      @map("owner_user_id")
  circleId            Int       @map("circle_id")
  findingKind         String    @map("finding_kind") @db.VarChar(64)
  level               String    @db.VarChar(16)
  riskLevel           String    @map("risk_level") @db.VarChar(16)
  severity            String    @db.VarChar(16)
  status              String    @default("open") @db.VarChar(24)
  title               String    @db.VarChar(160)
  summary             String
  explanation         String    @default("")
  evidenceRefs        Json      @default("[]") @map("evidence_refs") @db.JsonB
  suggestedAction     Json      @default("{}") @map("suggested_action") @db.JsonB
  sourceDigest        String    @map("source_digest") @db.Char(64)
  dedupeKey           String    @unique @map("dedupe_key") @db.VarChar(191)
  ruleVersion         String    @map("rule_version") @db.VarChar(64)
  modelProfile        String?   @map("model_profile") @db.VarChar(128)
  cooldownUntil       DateTime? @map("cooldown_until")
  notificationStatus  String    @default("skipped") @map("notification_status") @db.VarChar(24)
  notificationError   String?   @map("notification_error")
  convertedProposalId String?   @map("converted_proposal_id") @db.VarChar(96)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  circle Circle                 @relation(fields: [circleId], references: [id], onDelete: Cascade)
  events GuardianFindingEvent[]

  @@index([circleId, status, createdAt(sort: Desc)])
  @@index([circleId, level, createdAt(sort: Desc)])
  @@index([circleId, cooldownUntil])
  @@index([convertedProposalId])
  @@map("guardian_findings")
}

model GuardianFindingEvent {
  id           BigInt   @id @default(autoincrement())
  findingId    String   @map("finding_id") @db.VarChar(96)
  eventType    String   @map("event_type") @db.VarChar(32)
  actorUserId  Int?     @map("actor_user_id")
  eventPayload Json     @default("{}") @map("event_payload") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  finding GuardianFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt(sort: Desc)])
  @@map("guardian_finding_events")
}

model StylePreference {
