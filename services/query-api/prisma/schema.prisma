  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([requestedByUserId, cacheKey], map: "trend_prompt_cache_user_cache_key_key")
  @@index([requestedByUserId, taskType, createdAt(sort: Desc)], map: "trend_prompt_cache_user_task_created_idx")
  @@index([status, expiresAt(sort: Asc)], map: "trend_prompt_cache_status_expires_idx")
  @@index([aiJobId], map: "trend_prompt_cache_ai_job_idx")
