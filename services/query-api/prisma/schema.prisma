model TrendReceipt {
  id          String   @id @db.VarChar(96)
  sourceId    String   @map("source_id") @db.VarChar(96)
  sourceUrl   String?  @map("source_url")
  query       String   @db.VarChar(256)
  fetchedAt   DateTime @map("fetched_at")
  expiresAt   DateTime @map("expires_at")
  summary     String
  digest      String   @db.Char(64)
