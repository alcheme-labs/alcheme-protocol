model TrendSource {
  id              String   @id @db.VarChar(96)
  sourceKey       String   @unique(map: "trend_sources_source_key_key") @map("source_key") @db.VarChar(96)
  displayName     String   @map("display_name") @db.VarChar(160)
  sourceType      String   @map("source_type") @db.VarChar(32)
  owner           String   @db.VarChar(160)
  sourceUrl       String?  @map("source_url")
  allowedHosts    Json     @default("[]") @map("allowed_hosts") @db.JsonB
  secretScope     String   @default("none") @map("secret_scope") @db.VarChar(32)
  privacyProfile  String   @default("public_aggregate") @map("privacy_profile") @db.VarChar(32)
  loggingBoundary String   @default("summary_digest_only") @map("logging_boundary") @db.VarChar(64)
  budgetPolicy    Json     @default("{}") @map("budget_policy") @db.JsonB
  sourceConfig    Json     @default("{}") @map("source_config") @db.JsonB
