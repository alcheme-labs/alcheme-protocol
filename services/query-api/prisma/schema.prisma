// Prisma Schema - 基于 PostgreSQL Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement())
  handle      String  @unique @db.VarChar(32)
  pubkey      String  @unique @db.VarChar(44)
  displayName String? @map("display_name") @db.VarChar(128)
  bio         String?
  avatarUri   String? @map("avatar_uri")
  bannerUri   String? @map("banner_uri")
  website     String? @db.VarChar(256)
  location    String? @db.VarChar(128)
  metadataUri String? @map("metadata_uri")

  reputationScore Decimal @default(0) @map("reputation_score") @db.Decimal(10, 2)
  followersCount  Int     @default(0) @map("followers_count")
  followingCount  Int     @default(0) @map("following_count")
  postsCount      Int     @default(0) @map("posts_count")
  circlesCount    Int     @default(0) @map("circles_count")

  // Verification Fields (Off-Chain managed)
  email         String? @unique @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")

  twitterId       String? @unique @map("twitter_id") @db.VarChar(64)
  twitterHandle   String? @map("twitter_handle") @db.VarChar(32)
  twitterVerified Boolean @default(false) @map("twitter_verified")

  verificationLevel Int @default(0) @map("verification_level") // 0: None, 1: Email, 2: Twitter, 3: Both

  onChainAddress String @map("on_chain_address") @db.VarChar(44)
  lastSyncedSlot BigInt @map("last_synced_slot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  posts                              Post[]                              @relation("AuthorPosts")
  followers                          Follow[]                            @relation("Following")
  following                          Follow[]                            @relation("Follower")
  likes                              Like[]
  sentMessages                       Message[]                           @relation("MessageSender")
  receivedMessages                   Message[]                           @relation("MessageRecipient")
  circleMembers                      CircleMember[]
  circleAliases                      CircleAlias[]
  joinRequests                       CircleJoinRequest[]                 @relation("CircleJoinRequestUser")
  reviewedJoinRequests               CircleJoinRequest[]                 @relation("CircleJoinRequestReviewer")
  sentInvites                        CircleInvite[]                      @relation("CircleInviteSender")
  targetedInvites                    CircleInvite[]                      @relation("CircleInviteTarget")
  acceptedInvites                    CircleInvite[]                      @relation("CircleInviteAcceptor")
  membershipEvents                   CircleMembershipEvent[]             @relation("CircleMembershipEventUser")
  actedMembershipEvents              CircleMembershipEvent[]             @relation("CircleMembershipEventActor")
  createdCircles                     Circle[]                            @relation("CircleCreator")
  conversations                      Conversation[]                      @relation("ConversationCreator")
  conversationParticipants           ConversationParticipant[]
  authoredKnowledge                  Knowledge[]                         @relation("AuthoredKnowledge")
  draftComments                      DraftComment[]
  ghostDraftGenerationsRequested     GhostDraftGeneration[]              @relation("GhostDraftRequestedBy")
  ghostDraftAcceptances              GhostDraftAcceptance[]              @relation("GhostDraftAcceptedBy")
  acceptedDraftCandidates            DraftCandidateAcceptance[]          @relation("DraftCandidateAcceptedBy")
  attemptedDraftCandidateGenerations DraftCandidateGenerationAttempt[]   @relation("DraftCandidateAttemptedBy")
  approvedCircleDraftPromptVersions  CircleDraftPromptVersion[]          @relation("CircleDraftPromptApprovedBy")
  circleDraftPromptEvents            CircleDraftPromptEvent[]            @relation("CircleDraftPromptEventActor")
  createdAgents                      Agent[]                             @relation("AgentCreatedBy")
  ownedAgents                        Agent[]                             @relation("AgentOwner")
  updatedAgentPolicies               CircleAgentPolicy[]                 @relation("AgentPolicyUpdatedBy")
  notifications                      Notification[]
  governanceCaseAttentionPreferences GovernanceCaseAttentionPreference[]
  governanceCaseReadCursors          GovernanceCaseReadCursor[]
  totem                              UserTotem?
  crystalEntitlements                CrystalEntitlement[]                @relation("CrystalEntitlementOwnerUser")
  crystalReceipts                    CrystalReceipt[]                    @relation("CrystalReceiptOwnerUser")
  publicDemoAdmissions               PublicDemoAdmission[]

  @@index([handle])
  @@index([pubkey])
  @@index([reputationScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([onChainAddress])
  @@map("users")
}

model PublicDemoAdmission {
  id                   String   @id @default(uuid())
  userId               Int?     @map("user_id")
  walletPublicKey      String   @map("wallet_public_key") @db.VarChar(44)
  policyVersion        String   @map("policy_version") @db.VarChar(96)
  jurisdiction         String   @db.VarChar(16)
  region               String   @db.VarChar(16)
  adultAttested        Boolean  @map("adult_attested")
  termsAccepted        Boolean  @map("terms_accepted")
  privacyAccepted      Boolean  @map("privacy_accepted")
  safetyPolicyAccepted Boolean  @map("safety_policy_accepted")
  signedMessageDigest  String   @map("signed_message_digest") @db.Char(64)
  acceptanceDigest     String   @map("acceptance_digest") @db.Char(64)
  acceptedAt           DateTime @map("accepted_at")
  createdAt            DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, map: "public_demo_admission_user_fkey")

  @@unique([userId, policyVersion], map: "public_demo_admission_user_policy_key")
  @@unique([walletPublicKey, policyVersion], map: "public_demo_admission_wallet_policy_key")
  @@index([policyVersion, acceptedAt(sort: Desc)], map: "public_demo_admission_policy_accepted_idx")
  @@map("public_demo_admissions")
}

model Post {
  id        Int    @id @default(autoincrement())
  contentId String @unique @map("content_id") @db.VarChar(128)
  authorId  Int    @map("author_id")

  text            String?
  draftTitle      String? @map("draft_title") @db.VarChar(160)
  contentType     String  @map("content_type") @db.VarChar(32)
  storageUri      String? @map("storage_uri")
  storageProvider String? @map("storage_provider") @db.VarChar(32)

  parentPostId    Int?    @map("parent_post_id")
  threadRootId    Int?    @map("thread_root_id")
  repostOfPostId  Int?    @map("repost_of_post_id")
  repostOfAddress String? @map("repost_of_address") @db.VarChar(44)
  replyDepth      Int     @default(0) @map("reply_depth")

  circleId Int?     @map("circle_id")
  tags     String[] @default([])

  likesCount    Int     @default(0) @map("likes_count")
  repostsCount  Int     @default(0) @map("reposts_count")
  repliesCount  Int     @default(0) @map("replies_count")
  commentsCount Int     @default(0) @map("comments_count")
  sharesCount   Int     @default(0) @map("shares_count")
  viewsCount    Int     @default(0) @map("views_count")
  heatScore     Decimal @default(0) @map("heat_score") @db.Decimal(10, 4)

  status            PostStatus @default(Active)
  visibility        Visibility @default(Public)
  v2VisibilityLevel String?    @map("v2_visibility_level") @db.VarChar(32)
  v2AudienceKind    String?    @map("v2_audience_kind") @db.VarChar(32)
  v2AudienceRef     Int?       @map("v2_audience_ref")
  v2Status          String?    @map("v2_status") @db.VarChar(32)
  isV2Private       Boolean    @default(false) @map("is_v2_private")
  isV2Draft         Boolean    @default(false) @map("is_v2_draft")
  onChainAddress    String     @map("on_chain_address") @db.VarChar(44)
  lastSyncedSlot    BigInt     @map("last_synced_slot")
  downranked        Boolean    @default(false)
  downrankFactorBps Int?       @map("downrank_factor_bps")
  downrankedAt      DateTime?  @map("downranked_at")
  downrankExpiresAt DateTime?  @map("downrank_expires_at")
  downrankReasonCode String?   @map("downrank_reason_code") @db.VarChar(96)
  downrankEvidenceDigest String? @map("downrank_evidence_digest") @db.Char(64)
  downrankOperationReceiptId String? @map("downrank_operation_receipt_id") @db.VarChar(96)
  downrankOperationEffectId String? @unique(map: "post_downrank_effect_key") @map("downrank_operation_effect_id") @db.VarChar(96)
  safetyQuarantined        Boolean   @default(false) @map("safety_quarantined")
  safetyQuarantinedAt      DateTime? @map("safety_quarantined_at")
  safetyQuarantineExpiresAt DateTime? @map("safety_quarantine_expires_at")
  safetyQuarantineReasonCode String?  @map("safety_quarantine_reason_code") @db.VarChar(96)
  safetyQuarantinePolicyRef String?   @map("safety_quarantine_policy_ref") @db.VarChar(128)
  safetyQuarantineIncidentRef String? @map("safety_quarantine_incident_ref") @db.VarChar(128)
  safetyQuarantineEvidenceDigest String? @map("safety_quarantine_evidence_digest") @db.Char(64)
  safetyQuarantineOriginalVisibility String? @map("safety_quarantine_original_visibility") @db.VarChar(32)
  safetyQuarantineOperationReceiptId String? @map("safety_quarantine_operation_receipt_id") @db.VarChar(96)
  safetyQuarantineOperationEffectId String? @unique(map: "post_safety_quarantine_effect_key") @map("safety_quarantine_operation_effect_id") @db.VarChar(96)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  author                           User                              @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Cascade)
  parentPost                       Post?                             @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: SetNull)
  replies                          Post[]                            @relation("PostReplies")
  threadRoot                       Post?                             @relation("ThreadRoot", fields: [threadRootId], references: [id], onDelete: SetNull)
  thread                           Post[]                            @relation("ThreadRoot")
  repostOf                         Post?                             @relation("PostReposts", fields: [repostOfPostId], references: [id], onDelete: SetNull)
  reposts                          Post[]                            @relation("PostReposts")
  circle                           Circle?                           @relation(fields: [circleId], references: [id], onDelete: SetNull)
  likes                            Like[]
  contentInteractionEvents         ContentInteractionEvent[]
  draftComments                    DraftComment[]
  ghostDraftGenerations            GhostDraftGeneration[]
  ghostDraftAcceptances            GhostDraftAcceptance[]
  draftCandidateAcceptance         DraftCandidateAcceptance?
  draftCandidateGenerationAttempts DraftCandidateGenerationAttempt[]
  downrankOperationReceipt          OperationReceipt?                  @relation("PostContentVisibilityDownrankReceipt", fields: [downrankOperationReceiptId], references: [id], onDelete: Restrict)
  downrankOperationEffect           OperationEffect?                   @relation("PostContentVisibilityDownrankEffect", fields: [downrankOperationEffectId], references: [id], onDelete: Restrict)
  safetyQuarantineOperationReceipt  OperationReceipt?                  @relation("PostPlatformSafetyQuarantineReceipt", fields: [safetyQuarantineOperationReceiptId], references: [id], onDelete: Restrict)
  safetyQuarantineOperationEffect   OperationEffect?                   @relation("PostPlatformSafetyQuarantineEffect", fields: [safetyQuarantineOperationEffectId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([v2VisibilityLevel, v2Status])
  @@index([v2AudienceKind, v2AudienceRef])
  @@index([threadRootId])
  @@index([parentPostId])
  @@index([repostOfPostId])
  @@index([circleId])
  @@index([circleId, downranked, createdAt(sort: Desc)], map: "post_circle_downrank_created_idx")
  @@index([downranked, downrankExpiresAt], map: "post_downrank_expiry_idx")
  @@index([circleId, safetyQuarantined, createdAt(sort: Desc)], map: "post_circle_safety_quarantine_created_idx")
  @@index([safetyQuarantined, safetyQuarantineExpiresAt], map: "post_safety_quarantine_expiry_idx")
  @@index([onChainAddress])
  @@map("posts")
}

model FeedRankingPolicyVersion {
  id                 String    @id @db.VarChar(96)
  circleId           Int       @map("circle_id")
  version            Int
  status             String    @db.VarChar(24)
  signals            Json      @db.JsonB
  targetScope        String    @map("target_scope") @db.VarChar(48)
  defaultFactorBps   Int       @map("default_factor_bps")
  maxDurationSeconds Int       @map("max_duration_seconds")
  maxActiveRatioBps  Int       @map("max_active_ratio_bps")
  prospectiveOnly    Boolean   @default(true) @map("prospective_only")
  aiActivation       Boolean   @default(false) @map("ai_activation")
  configDigest       String    @map("config_digest") @db.Char(64)
  sourceReceiptId    String?   @unique(map: "feed_ranking_policy_receipt_key") @map("source_receipt_id") @db.VarChar(96)
  sourceEffectId     String?   @unique(map: "feed_ranking_policy_effect_key") @map("source_effect_id") @db.VarChar(96)
  activatedAt        DateTime  @map("activated_at")
  supersededAt       DateTime? @map("superseded_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  circle        Circle            @relation(fields: [circleId], references: [id], onDelete: Restrict)
  sourceReceipt OperationReceipt? @relation("FeedRankingPolicyReceipt", fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  sourceEffect  OperationEffect?  @relation("FeedRankingPolicyEffect", fields: [sourceEffectId], references: [id], onDelete: Restrict)

  @@unique([circleId, version], map: "feed_ranking_policy_circle_version_key")
  @@index([circleId, status, version(sort: Desc)], map: "feed_ranking_policy_active_idx")
  @@map("feed_ranking_policy_versions")
}

enum PostStatus {
  Active // 活跃 (= Published，兼容旧数据)
  Draft // 草稿
  Published // 已发布
  Archived // 已归档
  Deleted // 已删除
  Moderated // 审核中
  Suspended // 已暂停
  Flagged // 已标记
  UnderReview // 审核中 (链上状态)
  Hidden // 隐藏 (客户端侧状态)
}

enum Visibility {
  Public
  CircleOnly
  FollowersOnly
  Private
}

model Circle {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(128)
  description String?
  avatarUri   String? @map("avatar_uri")
  bannerUri   String? @map("banner_uri")

  creatorId Int @map("creator_id")

  circleType      CircleType      @default(Open) @map("circle_type")
  joinRequirement JoinRequirement @default(Free) @map("join_requirement")

  // 层级结构
  level          Int     @default(0) // 0=Plaza, 1=Crucible, 2=Sanctuary
  parentCircleId Int?    @map("parent_circle_id")
  knowledgeCount Int     @default(0) @map("knowledge_count")
  genesisMode    String? @map("genesis_mode") @db.VarChar(32) // canonical truth: 'BLANK' | 'SEEDED'

  membersCount Int @default(0) @map("members_count")
  postsCount   Int @default(0) @map("posts_count")

  // Derived from on-chain flags bitfield
  kind             String                @default("main") @db.VarChar(16) // "main" | "auxiliary"
  mode             String                @default("knowledge") @db.VarChar(16) // "knowledge" | "social"
  minCrystals      Int                   @default(0) @map("min_crystals") // bits 2-17 of flags
  lifecycleStatus  CircleLifecycleStatus @default(Active) @map("lifecycle_status")
  archivedAt       DateTime?             @map("archived_at")
  archivedByPubkey String?               @map("archived_by_pubkey") @db.VarChar(44)
  archiveReason    String?               @map("archive_reason")

  onChainAddress String @unique @map("on_chain_address") @db.VarChar(44)
  lastSyncedSlot BigInt @map("last_synced_slot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  creator                          User                              @relation("CircleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  parentCircle                     Circle?                           @relation("CircleHierarchy", fields: [parentCircleId], references: [id], onDelete: SetNull)
  childCircles                     Circle[]                          @relation("CircleHierarchy")
  members                          CircleMember[]
  circleAliases                    CircleAlias[]
  joinRequests                     CircleJoinRequest[]
  invites                          CircleInvite[]
  membershipEvents                 CircleMembershipEvent[]
  posts                            Post[]
  knowledge                        Knowledge[]                       @relation("CircleKnowledge")
  crystalEntitlements              CrystalEntitlement[]
  crystalAssets                    CrystalAsset[]
  crystalReceipts                  CrystalReceipt[]
  knowledgeFrom                    Knowledge[]                       @relation("KnowledgeSource")
  seededSourceNodes                SeededSourceNode[]
  sourceMaterials                  SourceMaterial[]
  guardianFindings                 GuardianFinding[]
  externalAppBindings              ExternalAppCircleBinding[]
  agents                           Agent[]
  agentPolicy                      CircleAgentPolicy?
  acceptedDraftCandidates          DraftCandidateAcceptance[]
  draftCandidateGenerationAttempts DraftCandidateGenerationAttempt[]
  draftPromptVersions              CircleDraftPromptVersion[]
  draftPromptEvents                CircleDraftPromptEvent[]
  geoAnchors                       CircleGeoAnchor[]
  geoAnchorAuditEvents             CircleGeoAnchorAuditEvent[]
  locationDiscoveryRows            CircleLocationDiscoveryIndex[]
  governanceCompatibilityBundles   GovernanceCompatibilityBundle[]
  governanceLegacyActionCutovers   GovernanceLegacyActionCutover[]
  outboundMergeLineages            CircleMergeLineage[]              @relation("CircleMergeSource")
  inboundMergeLineages             CircleMergeLineage[]              @relation("CircleMergeSuccessor")
  feedRankingPolicyVersions        FeedRankingPolicyVersion[]

  @@index([creatorId])
  @@index([circleType])
  @@index([lifecycleStatus])
  @@index([level])
  @@index([parentCircleId])
  @@index([createdAt(sort: Desc)])
  @@index([membersCount(sort: Desc)])
  @@index([onChainAddress])
  @@map("circles")
}

enum CircleLifecycleStatus {
  Active
  Archived
  ForkPending
  MergePending
  Merged
  DissolutionPending
}

model CircleGeoAnchor {
  anchorId        String    @id @map("anchor_id") @db.VarChar(80)
  circleId        Int       @map("circle_id")
  role            String    @default("primary") @db.VarChar(24)
  geometryType    String    @default("point_radius") @map("geometry_type") @db.VarChar(32)
  label           String    @db.VarChar(128)
  centerLat       Decimal   @map("center_lat") @db.Decimal(9, 6)
  centerLng       Decimal   @map("center_lng") @db.Decimal(9, 6)
  radiusMeters    Int       @map("radius_meters")
  visibility      String    @default("public_discovery") @db.VarChar(32)
  status          String    @default("active") @db.VarChar(24)
  source          String    @default("manual") @db.VarChar(32)
  createdByPubkey String?   @map("created_by_pubkey") @db.VarChar(44)
  updatedByPubkey String?   @map("updated_by_pubkey") @db.VarChar(44)
  metadata        Json      @default("{}") @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  circle       Circle                        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  auditEvents  CircleGeoAnchorAuditEvent[]
  discoveryRow CircleLocationDiscoveryIndex?

  @@index([circleId])
  @@index([circleId, role, status, visibility])
  @@map("circle_geo_anchors")
}

model CircleGeoAnchorAuditEvent {
  eventId             String   @id @map("event_id") @db.VarChar(80)
  anchorId            String   @map("anchor_id") @db.VarChar(80)
  circleId            Int      @map("circle_id")
  actorPubkey         String?  @map("actor_pubkey") @db.VarChar(44)
  eventType           String   @map("event_type") @db.VarChar(32)
  previousValue       Json?    @map("previous_value") @db.JsonB
  nextValue           Json?    @map("next_value") @db.JsonB
  governanceRequestId String?  @map("governance_request_id") @db.VarChar(80)
  createdAt           DateTime @default(now()) @map("created_at")

  anchor CircleGeoAnchor @relation(fields: [anchorId], references: [anchorId], onDelete: Cascade)
  circle Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt(sort: Desc)])
  @@map("circle_geo_anchor_audit_events")
}

model CircleLocationDiscoveryIndex {
  anchorId     String   @id @map("anchor_id") @db.VarChar(80)
  circleId     Int      @map("circle_id")
  role         String   @db.VarChar(24)
  geometryType String   @map("geometry_type") @db.VarChar(32)
  label        String   @db.VarChar(128)
  centerLat    Decimal  @map("center_lat") @db.Decimal(9, 6)
  centerLng    Decimal  @map("center_lng") @db.Decimal(9, 6)
  radiusMeters Int      @map("radius_meters")
  visibility   String   @db.VarChar(32)
  status       String   @db.VarChar(24)
  rankHints    Json     @default("{}") @map("rank_hints") @db.JsonB
  updatedAt    DateTime @default(now()) @map("updated_at")

  anchor CircleGeoAnchor @relation(fields: [anchorId], references: [anchorId], onDelete: Cascade)
  circle Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([status, visibility])
  @@index([circleId])
  @@map("circle_location_discovery_index")
}

model SeededSourceNode {
  id             Int      @id @default(autoincrement())
  circleId       Int      @map("circle_id")
  parentId       Int?     @map("parent_id")
  nodeType       String   @map("node_type") @db.VarChar(16) // "directory" | "file"
  name           String   @db.VarChar(255)
  path           String   @db.VarChar(1024)
  depth          Int
  sortOrder      Int      @default(0) @map("sort_order")
  mimeType       String?  @map("mime_type") @db.VarChar(255)
  contentText    String?  @map("content_text")
  contentLocator String?  @map("content_locator")
  contentHash    String?  @map("content_hash") @db.Char(64)
  byteSize       Int      @default(0) @map("byte_size")
  lineCount      Int?     @map("line_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  circle   Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  parent   SeededSourceNode?  @relation("SeededSourceNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children SeededSourceNode[] @relation("SeededSourceNodeTree")

  @@unique([circleId, path])
  @@index([circleId, parentId, sortOrder])
  @@map("seeded_source_nodes")
}

model SourceMaterial {
  id                        Int       @id @default(autoincrement())
  circleId                  Int       @map("circle_id")
  uploadedByUserId          Int?      @map("uploaded_by_user_id")
  draftPostId               Int?      @map("draft_post_id")
  discussionThreadId        String?   @map("discussion_thread_id") @db.VarChar(64)
  seededSourceNodeId        Int?      @map("seeded_source_node_id")
  name                      String    @db.VarChar(255)
  mimeType                  String?   @map("mime_type") @db.VarChar(255)
  byteSize                  Int       @default(0) @map("byte_size")
  extractionStatus          String    @default("ready") @map("extraction_status") @db.VarChar(32)
  rawText                   String?   @map("raw_text")
  rawTextLocator            String?   @map("raw_text_locator")
  contentDigest             String    @map("content_digest") @db.Char(64)
  originType                String    @default("manual_upload") @map("origin_type") @db.VarChar(32)
  originRef                 String?   @map("origin_ref") @db.VarChar(128)
  canonicalUrl              String?   @map("canonical_url") @db.VarChar(2048)
  externalAuthorLabel       String?   @map("external_author_label") @db.VarChar(160)
  sourcePublishedAt         DateTime? @map("source_published_at")
  capturedAt                DateTime? @map("captured_at")
  sourceVersion             Int?      @map("source_version")
  previousVersionId         Int?      @unique @map("previous_version_id")
  externalAppId             String?   @map("external_app_id") @db.VarChar(64)
  roomKey                   String?   @map("room_key") @db.VarChar(96)
  lifecycleStatus           String    @default("accepted_to_plaza") @map("lifecycle_status") @db.VarChar(32)
  summaryText               String?   @map("summary_text")
  evidencePrivacyClass      String    @default("public") @map("evidence_privacy_class") @db.VarChar(24)
  visibilityScope           String    @default("circle") @map("visibility_scope") @db.VarChar(24)
  submittedByPubkey         String?   @map("submitted_by_pubkey") @db.VarChar(44)
  reviewRequestId           String?   @map("review_request_id") @db.VarChar(96)
  reviewDecisionDigest      String?   @map("review_decision_digest") @db.Char(64)
  expiresAt                 DateTime? @map("expires_at")
  provenance                Json?
  licenseFacts              Json?     @map("license_facts") @db.JsonB
  licenseFactsDigest        String?   @map("license_facts_digest") @db.Char(64)
  licenseAuthorizedByPubkey String?   @map("license_authorized_by_pubkey") @db.VarChar(44)
  licenseAuthorizedAt       DateTime? @map("license_authorized_at")
