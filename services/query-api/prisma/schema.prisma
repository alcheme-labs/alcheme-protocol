}

model GhostDraftAcceptance {
  id                          Int       @id @default(autoincrement())
  ghostDraftGenerationId      Int       @map("ghost_draft_generation_id")
  draftPostId                 Int       @map("draft_post_id")
  acceptedByUserId            Int       @map("accepted_by_user_id")
  acceptanceMode              String    @map("acceptance_mode") @db.VarChar(32)
  acceptedSuggestionId        String?   @map("accepted_suggestion_id") @db.VarChar(191)
  acceptedThreadIds           Json?     @map("accepted_thread_ids")
  requestWorkingCopyHash      String?   @map("request_working_copy_hash") @db.Char(64)
  requestWorkingCopyUpdatedAt DateTime? @map("request_working_copy_updated_at")
  resultingWorkingCopyHash    String    @map("resulting_working_copy_hash") @db.Char(64)
  changed                     Boolean   @default(true)
  acceptedAt                  DateTime  @default(now()) @map("accepted_at")
  createdAt                   DateTime  @default(now()) @map("created_at")

  generation GhostDraftGeneration @relation(fields: [ghostDraftGenerationId], references: [id], onDelete: Cascade)
