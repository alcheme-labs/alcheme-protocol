  status      String   @default("fresh") @db.VarChar(24)
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  source TrendSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, cacheKey], map: "trend_receipts_source_cache_key_key")
  @@index([cacheKey, status, expiresAt(sort: Desc)])
  @@index([status, expiresAt(sort: Desc)])
  @@map("trend_receipts")
}

model TrendPromptCache {
  id                    String    @id @db.VarChar(96)
  cacheKey              String    @map("cache_key") @db.VarChar(191)
  taskType              String    @map("task_type") @db.VarChar(96)
  requestedByUserId     Int       @map("requested_by_user_id")
  inputDigest           String    @map("input_digest") @db.Char(64)
  sanitizedIntentDigest String    @map("sanitized_intent_digest") @db.Char(64)
