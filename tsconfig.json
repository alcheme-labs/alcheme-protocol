{
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node", "mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["extensions/**/*.ts"],
  "exclude": ["node_modules", "target"]
}
